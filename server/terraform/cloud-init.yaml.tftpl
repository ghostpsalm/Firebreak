#cloud-config
# Everything the collector needs except its own source, which Terraform
# copies up straight afterwards (see null_resource.receiver in main.tf).
# There is no build step — the receiver is TypeScript and Deno runs it — so
# this box is provisioned in a couple of minutes rather than ten.
#
# Note for editors: this file goes through Terraform's `templatefile`, so a
# bare dollar-brace is an interpolation and gets substituted. To write a
# literal one for the shell, double the dollar sign: $${HOME}.

package_update: true
package_upgrade: true

packages:
  - nginx
  - certbot
  - python3-certbot-nginx
  - curl
  - unzip
  - sqlite3
  - iptables-persistent

# Not needed for a build any more, but a 1 GB box still runs apt upgrades
# and nginx alongside a V8 heap. Cheap insurance against the OOM reaper.
swap:
  filename: /swapfile
  size: 1073741824
  maxsize: 1073741824

users:
  # `default` MUST stay first. A users: list replaces the distro's default
  # set rather than adding to it, so dropping this line means the `ubuntu`
  # user is never created, the injected SSH key has nowhere to land, and the
  # box locks out both Terraform's provisioner and you on first boot.
  - default
  - name: firebreak
    system: true
    shell: /usr/sbin/nologin
    # No home, no login, no password. It exists to own one database file.
    lock_passwd: true
  # The account CI deploys through. It needs a real shell because that is
  # what runs the forced command, but the key installed for it in runcmd
  # below can only ever invoke /usr/local/bin/firebreak-deploy — no shell,
  # no port forwarding, no file reads. It owns /opt/firebreak-receiver so a
  # deploy needs no root for the copy, and sudo for exactly one restart.
  - name: deploy
    gecos: CI deploy account (forced command only)
    shell: /bin/bash
    lock_passwd: true
    # Only so the deploy script can quote the service's journal back into
    # the CI log when a restart fails. It changes nothing about what the
    # key can *do* — the forced command is still the only entry point, and
    # the script decides what is printed.
    groups: [systemd-journal]

write_files:
  # ---- the reverse proxy ----
  #
  # HTTP only at this point. certbot rewrites this block in place to add TLS
  # and a redirect once a certificate exists — see firebreak-certbot below.
  # Structured so a second service is a location block and a loopback port.
  - path: /etc/nginx/sites-available/firebreak
    owner: root:root
    permissions: '0644'
    content: |
      server {
          listen 80;
          listen [::]:80;
          server_name ${domain_name};

          # Off deliberately. nginx's access log records the full client
          # address, which would quietly undo the truncation the receiver
          # does before storing anything — the log next to the database
          # must not hold what the database is careful not to.
          access_log off;

          # The payload is ~300 bytes. The receiver caps the body itself;
          # this refuses the obvious cases an inch earlier.
          client_max_body_size 16k;

          add_header Strict-Transport-Security "max-age=31536000" always;
          add_header X-Content-Type-Options "nosniff" always;

          # Firebreak usage ping.
          location /v1/ {
              proxy_pass http://127.0.0.1:8787;
              proxy_http_version 1.1;
              proxy_set_header Host $host;
              # APPENDS the real peer to anything the client sent, which is
              # why the receiver reads the LAST entry. Do not change this to
              # $remote_addr alone without changing ping.ts to match.
              proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
              proxy_set_header X-Forwarded-Proto $scheme;
          }

          location = /healthz {
              proxy_pass http://127.0.0.1:8787;
              proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          }

          # ---- add further services here ----
          # Each gets its own loopback port and its own path prefix:
          #
          # location /thing/ {
          #     proxy_pass http://127.0.0.1:8788;
          #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          # }

          location / {
              default_type text/plain;
              return 200 "Firebreak collector.\n";
          }
      }

  - path: /etc/nginx/conf.d/firebreak-hardening.conf
    owner: root:root
    permissions: '0644'
    content: |
      # Nothing here is a web page; volunteer nothing about the server.
      server_tokens off;

  # ---- the service ----
  #
  # The permission flags on ExecStart are the security boundary worth
  # reading: one listening port, one directory, five environment variables,
  # and --no-remote so the process cannot pull code off the network. The
  # deployed receiver has no third-party dependency at all — only local
  # modules and Deno's built-in node:sqlite.
  - path: /etc/systemd/system/firebreak-receiver.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Firebreak telemetry collector
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      User=firebreak
      Group=firebreak
      # systemd creates and owns /var/lib/firebreak-receiver
      StateDirectory=firebreak-receiver
      Environment=FB_HOST=127.0.0.1
      Environment=FB_PORT=8787
      Environment=FB_DB=/var/lib/firebreak-receiver/telemetry.db
      Environment=FB_RETENTION_DAYS=${retention_days}
      Environment=FB_RATE_PER_HOUR=${rate_per_hour}
      Environment=DENO_NO_UPDATE_CHECK=1
      Environment=DENO_DIR=/var/lib/firebreak-receiver/.deno
      ExecStart=/usr/local/deno/bin/deno run \
          --no-remote \
          --allow-net=127.0.0.1:8787 \
          --allow-read=/var/lib/firebreak-receiver \
          --allow-write=/var/lib/firebreak-receiver \
          --allow-env=FB_HOST,FB_PORT,FB_DB,FB_RETENTION_DAYS,FB_RATE_PER_HOUR \
          /opt/firebreak-receiver/main.ts
      Restart=on-failure
      RestartSec=5

      # Deno confines the program; this confines the process. Belt and
      # braces, because they fail differently.
      NoNewPrivileges=yes
      PrivateTmp=yes
      PrivateDevices=yes
      ProtectSystem=strict
      ProtectHome=yes
      ProtectKernelTunables=yes
      ProtectKernelModules=yes
      ProtectControlGroups=yes
      RestrictAddressFamilies=AF_INET AF_INET6
      RestrictNamespaces=yes
      RestrictSUIDSGID=yes
      LockPersonality=yes
      SystemCallArchitectures=native
      SystemCallFilter=@system-service

      [Install]
      WantedBy=multi-user.target

  # ---- continuous deployment ----
  #
  # One restart, by exact unit name. Everything else a deploy does — the
  # copy, the backup, the health check — happens as the deploy user with no
  # elevation at all.
  - path: /etc/sudoers.d/firebreak-deploy
    owner: root:root
    permissions: '0440'
    content: |
      deploy ALL=(root) NOPASSWD: /usr/bin/systemctl restart firebreak-receiver

  - path: /usr/local/bin/firebreak-deploy
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # The forced command for the CI deploy key: the only thing that key can
      # do. stdin is a gzipped tar carrying the receiver's three modules.
      # Whatever the client asked to run is ignored — see the command="..."
      # prefix in /home/deploy/.ssh/authorized_keys.
      set -euo pipefail
      umask 022

      LIVE=/opt/firebreak-receiver
      BACKUP=/var/lib/firebreak-deploy/prev
      HEALTH=http://127.0.0.1:8787/healthz
      FILES=(main.ts ping.ts db.ts)

      log() { printf 'deploy: %s\n' "$*"; }

      tmp=$(mktemp -d)
      trap 'rm -rf "$tmp"' EXIT

      # Only the three named members are extracted. An archive carrying an
      # absolute path, a ../.. traversal, a symlink or simply an extra file
      # therefore writes nothing anywhere — the names are ours, not its.
      tar -xz -C "$tmp" --no-same-owner --no-same-permissions -- "$${FILES[@]}"
      for f in "$${FILES[@]}"; do
          [ -f "$tmp/$f" ] || { log "archive is missing $f"; exit 1; }
      done

      digest() {
          (cd "$1" 2>/dev/null && sha256sum "$${FILES[@]}" 2>/dev/null |
              sha256sum | cut -d' ' -f1) || echo none
      }
      if [ "$(digest "$tmp")" = "$(digest "$LIVE")" ]; then
          log "already running this exact code — not restarting a working service"
          exit 0
      fi

      # Typechecked before it goes anywhere near the live directory.
      # --no-remote so this cannot reach the network, and a private DENO_DIR
      # so it needs no write access outside the scratch directory.
      if ! DENO_DIR="$tmp/.deno" /usr/local/deno/bin/deno check --no-remote \
              "$tmp/main.ts" >/dev/null 2>&1; then
          log "typecheck failed — refusing to install"
          exit 1
      fi

      mkdir -p "$BACKUP"
      cp -f "$LIVE"/*.ts "$BACKUP"/ 2>/dev/null || true

      install -m 0644 "$tmp"/*.ts "$LIVE"/
      sudo /usr/bin/systemctl restart firebreak-receiver

      for _ in $(seq 1 15); do
          if curl -fsS --max-time 2 "$HEALTH" >/dev/null 2>&1; then
              log "deployed and healthy"
              exit 0
          fi
          sleep 2
      done

      # A green pipeline over a collector that stopped answering is worse
      # than a red one, so this fails loudly and puts the old code back.
      #
      # The service's own log goes out on stdout first, so the reason lands
      # in the CI run alongside the failure. The deploy key cannot open a
      # shell to go and look afterwards — by design — so if this does not
      # print it, nobody ever sees it.
      log "did not come back healthy — rolling back. Its last words:"
      journalctl -u firebreak-receiver -n 40 --no-pager 2>&1 |
          sed 's/^/    /' || log "(could not read the journal)"
      if compgen -G "$BACKUP/*.ts" >/dev/null; then
          install -m 0644 "$BACKUP"/*.ts "$LIVE"/
          sudo /usr/bin/systemctl restart firebreak-receiver
          log "rolled back to the previous version"
      else
          log "no previous version to roll back to"
      fi
      exit 1

  # ---- certificate issuance ----
  #
  # Run on a timer rather than once at boot, because DNS may not point here
  # yet when the box is built. It is a no-op the moment a certificate
  # exists; ordinary renewal is then certbot's own packaged timer.
  - path: /usr/local/bin/firebreak-certbot
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      DOMAIN=${domain_name}
      EMAIL=${acme_email}
      if [ -f "/etc/letsencrypt/live/$DOMAIN/fullchain.pem" ]; then
          exit 0
      fi
      # --redirect makes port 80 a 308 to https, leaving only the ACME
      # challenge served in plaintext.
      certbot --nginx -d "$DOMAIN" --non-interactive --agree-tos \
          -m "$EMAIL" --redirect --keep-until-expiring

  - path: /etc/systemd/system/firebreak-certbot.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Obtain the collector's TLS certificate once DNS resolves
      After=network-online.target nginx.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/firebreak-certbot

  - path: /etc/systemd/system/firebreak-certbot.timer
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Keep trying for the collector's certificate until DNS points here

      [Timer]
      OnBootSec=2min
      OnUnitActiveSec=10min

      [Install]
      WantedBy=timers.target

  # ---- keep the evidence ----
  #
  # A volatile journal is emptied by the reboot, which is very often the
  # thing you wanted to read about. Capped so it can never be the reason a
  # 50 GB boot volume fills up.
  - path: /etc/systemd/journald.conf.d/firebreak.conf
    owner: root:root
    permissions: '0644'
    content: |
      [Journal]
      Storage=persistent
      SystemMaxUse=200M
      SystemMaxFileSize=20M
      MaxRetentionSec=1month

  # ---- what to send when something is wrong ----
  #
  # The counterpart of the client's --export-support: one command that
  # gathers every log that matters, so diagnosing a bad build is not a
  # memory test about which of six files to look in.
  - path: /usr/local/bin/firebreak-collector-support
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # Everything needed to diagnose this host, on stdout. Run with sudo.
      #   ssh ubuntu@<ip> 'sudo firebreak-collector-support' > support.txt
      #
      # Review before sharing: nginx and certbot error logs can quote client
      # addresses, which nothing else here does.
      set -uo pipefail

      section() { printf '\n===== %s =====\n' "$*"; }
      run() { section "$*"; "$@" 2>&1 || echo "(command failed: $*)"; }

      echo "firebreak collector support bundle"
      echo "generated: $(date -Is)"

      run uname -a
      run uptime
      run /usr/local/deno/bin/deno --version

      section "cloud-init (did the box build correctly?)"
      cloud-init status --long 2>&1 || true
      section "cloud-init output, last 120 lines"
      tail -n 120 /var/log/cloud-init-output.log 2>&1 || true

      run systemctl status firebreak-receiver --no-pager --full
      section "receiver journal, last 200 lines"
      journalctl -u firebreak-receiver -n 200 --no-pager 2>&1 || true

      run systemctl status nginx --no-pager
      section "nginx error log, last 60 lines"
      tail -n 60 /var/log/nginx/error.log 2>&1 || true
      run nginx -t

      section "certificate"
      certbot certificates 2>&1 || true
      section "letsencrypt log, last 60 lines"
      tail -n 60 /var/log/letsencrypt/letsencrypt.log 2>&1 || true
      run systemctl status firebreak-certbot.timer --no-pager

      section "what is deployed"
      ls -la /opt/firebreak-receiver 2>&1
      sha256sum /opt/firebreak-receiver/*.ts 2>&1

      section "listening sockets"
      ss -ltnp 2>&1 || true
      run iptables -S

      section "disk and memory"
      df -h / 2>&1
      free -m 2>&1

      section "database (shape only, no contents)"
      DB=/var/lib/firebreak-receiver/telemetry.db
      if [ -f "$DB" ]; then
          ls -la "$DB"*
          sqlite3 "$DB" "SELECT COUNT(*) AS rows, MIN(day) AS first, MAX(day) AS last FROM ping;" 2>&1
      else
          echo "no database yet — nothing has been received"
      fi

  # ---- a look at the data ----
  - path: /usr/local/bin/firebreak-telemetry-summary
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # Quick look at what has been collected.
      set -euo pipefail
      DB=/var/lib/firebreak-receiver/telemetry.db
      echo "== installs seen per day (last 14) =="
      sqlite3 -column -header "$DB" \
        "SELECT day, COUNT(DISTINCT install_id) AS installs
           FROM ping GROUP BY day ORDER BY day DESC LIMIT 14;"
      echo
      echo "== platforms (last 30 days) =="
      sqlite3 -column -header "$DB" \
        "SELECT os, os_name, os_version, backend, COUNT(DISTINCT install_id) AS installs
           FROM ping WHERE day >= date('now','-30 days')
          GROUP BY os, os_name, os_version, backend ORDER BY installs DESC;"
      echo
      echo "== features (last 30 days) =="
      sqlite3 -column -header "$DB" \
        "SELECT features, COUNT(DISTINCT install_id) AS installs
           FROM ping WHERE day >= date('now','-30 days')
          GROUP BY features ORDER BY installs DESC;"

runcmd:
  # Oracle's Ubuntu images ship a restrictive INPUT chain that only allows
  # SSH. The VCN security list is one half of the story; this is the other,
  # and forgetting it is the classic "why does Let's Encrypt time out".
  - iptables -I INPUT 1 -p tcp --dport 80 -j ACCEPT
  - iptables -I INPUT 1 -p tcp --dport 443 -j ACCEPT
  - netfilter-persistent save

  # Deno, pinned. An unpinned runtime on a box you do not watch is a
  # surprise waiting for a quiet week; bump deno_version deliberately.
  - curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local/deno sh -s -- -y ${deno_version}
  - /usr/local/deno/bin/deno --version

  # Owned by the deploy account so a deploy is a plain file copy with no
  # elevation. The service only ever reads from here.
  - install -d -m 0755 -o deploy -g deploy /opt/firebreak-receiver
  - install -d -m 0700 -o deploy -g deploy /var/lib/firebreak-deploy

  # Installed here rather than in write_files because cloud-init writes
  # files before it creates users, which would leave ~deploy/.ssh owned by
  # root and the key ignored. Empty deploy_public_key means no CI account.
  - |
    KEY='${deploy_public_key}'
    if [ -n "$KEY" ]; then
      install -d -m 0700 -o deploy -g deploy /home/deploy/.ssh
      printf 'command="/usr/local/bin/firebreak-deploy",restrict %s\n' "$KEY" \
        > /home/deploy/.ssh/authorized_keys
      chown deploy:deploy /home/deploy/.ssh/authorized_keys
      chmod 0600 /home/deploy/.ssh/authorized_keys
      echo "deploy account armed"
    else
      echo "no deploy_public_key set - CI deployment is not configured"
    fi
  - visudo -cf /etc/sudoers.d/firebreak-deploy

  # Apply the journal settings now, so the first boot's own logs survive it.
  - systemctl restart systemd-journald

  - rm -f /etc/nginx/sites-enabled/default
  - ln -sf /etc/nginx/sites-available/firebreak /etc/nginx/sites-enabled/firebreak
  - nginx -t
  - systemctl restart nginx

  # The unit is enabled now and started by Terraform once main.ts is up.
  # It will restart-loop until then, which is expected and harmless.
  - systemctl daemon-reload
  - systemctl enable firebreak-receiver
  - systemctl enable --now firebreak-certbot.timer
